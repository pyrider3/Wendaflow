{
  "name": "wendaflow",
  "private": true,
  "version": "0.2.15",
  "license": "AGPL-3.0-only",
  "description": "AI conversations on a branching canvas",
  "homepage": "https://cn.qnjyxh.xyz",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node server.mjs",
    "app": "concurrently -k \"npm:dev\" \"npm:proxy\"",
    "build": "npm run audit:i18n && vite build",
    "preview": "vite preview",
    "make-icon": "node scripts/make-icon.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test:quick-thought": "node --test src/quick-thought/*.test.mjs",
    "test:canvas": "node --test src/canvas/*.test.mjs",
    "test": "node --test src/canvas/*.test.mjs src/quick-thought/*.test.mjs src/agents/*.test.mjs",
    "test:public": "node --test deployment/*.test.mjs",
    "test:cloud": "node --test cloud/*.test.mjs",
    "build:windows": "npm run build && node scripts/windows/build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "concurrently": "^10.0.5",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyrider3/Wendaflow.git"
  },
  "bugs": {
    "url": "https://github.com/pyrider3/Wendaflow/issues"
  }
}
